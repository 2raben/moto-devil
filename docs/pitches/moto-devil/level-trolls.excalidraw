      "boundElements": null,
      "updated": 1762944000000,
      "link": null,
      "locked": false,
      "text": "Sieht aus wie eine Stuntstrecke. Jede rote Zahl ist eine Falle, die beim ersten Mal zuschlägt. Stacheln (2) kann man beim zweiten Mal überspringen.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sieht aus wie eine Stuntstrecke. Jede rote Zahl ist eine Falle, die beim ersten Mal zuschlägt. Stacheln (2) kann man beim zweiten Mal überspringen.",
      "autoResize": true,
      "lineHeight": 1.25
    },
